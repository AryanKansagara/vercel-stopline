{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node scripts/build-frontend.mjs",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/app/",
      "destination": "/app.html"
    },
    {
      "source": "/api/profile-runs/:runId/stream",
      "destination": "/api/stream?runId=:runId&product=1"
    },
    {
      "source": "/api/profile-runs/:runId/export",
      "destination": "/api/product?route=export&runId=:runId"
    },
    {
      "source": "/api/profile-runs/:runId",
      "destination": "/api/product?route=run&runId=:runId"
    },
    {
      "source": "/api/profile-runs",
      "destination": "/api/product?route=runs"
    },
    {
      "source": "/api/workspaces/current",
      "destination": "/api/product?route=workspace-current"
    },
    {
      "source": "/api/workspaces",
      "destination": "/api/product?route=workspaces"
    },
    {
      "source": "/api/runs/:runId/stream",
      "destination": "/api/stream?runId=:runId"
    },
    {
      "source": "/api/:path*",
      "destination": "https://stopline-production-05c5.up.railway.app/api/:path*"
    },
    {
      "source": "/healthz",
      "destination": "https://stopline-production-05c5.up.railway.app/healthz"
    },
    {
      "source": "/readyz",
      "destination": "https://stopline-production-05c5.up.railway.app/readyz"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-transform"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    }
  ],
  "functions": {
    "api/stream.mjs": {
      "supportsCancellation": true,
      "maxDuration": 30
    },
    "api/product.mjs": {
      "supportsCancellation": true,
      "maxDuration": 30
    }
  }
}
